# ===================================================================
# CattleFeedAI — Root Environment Configuration Template
# Copy this file to .env and configure secrets appropriately for production.
# NEVER commit production passwords, API keys, or JWT secrets to source control.
# ===================================================================

# Database Configuration (MySQL 8+)
DB_URL=jdbc:mysql://localhost:3306/cattlefeedai?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_secure_db_password

# JWT Authentication
# MUST be overridden with a cryptographically secure 256-bit base64 secret in production:
JWT_SECRET=your_base64_encoded_256_bit_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000

# Backend Server Port
SERVER_PORT=8080

# AI Microservice (FastAPI) Configuration
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=3000

# React Native / Expo Frontend Configuration
# For local dev / emulator / LAN physical testing:
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
EXPO_PUBLIC_AI_SERVICE_URL=http://localhost:8000
