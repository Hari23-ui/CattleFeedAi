# ===================================================================
# CattleFeedAI Frontend — Expo / React Native Environment Configuration
# Copy this file to .env or .env.local for local overrides.
# ===================================================================

# Spring Boot REST API Base URL
# - iOS Simulator / Web: http://localhost:8080
# - Android Emulator:    http://10.0.2.2:8080
# - Physical Device:     http://<YOUR_LOCAL_LAN_IP>:8080 (e.g. http://192.168.1.50:8080)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# FastAPI AI Microservice URL (Direct Client Access if configured)
# - iOS Simulator / Web: http://localhost:8000
# - Android Emulator:    http://10.0.2.2:8000
# - Physical Device:     http://<YOUR_LOCAL_LAN_IP>:8000
EXPO_PUBLIC_AI_SERVICE_URL=http://localhost:8000
